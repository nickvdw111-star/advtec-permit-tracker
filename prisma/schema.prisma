generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model School {
  id        String    @id @default(cuid())
  name      String
  location  String?
  createdAt DateTime  @default(now())
  users     User[]
  teachers  Teacher[]
}

model User {
  id        String     @id @default(cuid())
  name      String
  email     String     @unique
  password  String
  role      Role       @default(ADMIN)
  schoolId  String?
  school    School?    @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  createdAt DateTime   @default(now())
  auditLogs AuditLog[]
}

model Teacher {
  id                  String      @id @default(cuid())
  surname             String
  name                String
  employeeNo          String      @unique
  schoolId            String
  school              School      @relation(fields: [schoolId], references: [id])
  department          String
  subject             String
  countryOfOrigin     String
  dateOfBirth         DateTime
  employmentStartDate DateTime
  contractStart       DateTime?
  contractEnd         DateTime?
  teacherType         TeacherType
  gender              String
  performanceRating   String?
  notes               String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  permits             Permit[]
  auditLogs           AuditLog[]
}

model Permit {
  id                   String         @id @default(cuid())
  teacherId            String
  teacher              Teacher        @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  permitType           PermitType
  startDate            DateTime
  endDate              DateTime
  workflowStatus       WorkflowStatus @default(NONE)
  submittedToAgentDate DateTime?
  submittedToGovtDate  DateTime?
  comments             String?
  nextSteps            String?
  nextStepsComplete    Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  auditLogs            AuditLog[]
}

model AuditLog {
  id           String   @id @default(cuid())
  entityType   String
  entityId     String
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  teacherId    String?
  teacher      Teacher? @relation(fields: [teacherId], references: [id])
  permitId     String?
  permit       Permit?  @relation(fields: [permitId], references: [id])
  action       String
  fieldChanged String?
  oldValue     String?
  newValue     String?
  timestamp    DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([timestamp])
}

enum Role {
  ADMIN
  OPS_MANAGER
}

enum TeacherType {
  EXPAT
  LOCAL
}

enum PermitType {
  PERMISSION_TO_TEACH
  PERMISSION_TO_WORK
  WORK_PERMIT
}

enum WorkflowStatus {
  NONE
  IN_PROGRESS
  IN_APPEAL
}
